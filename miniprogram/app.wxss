page {
  background-color: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 20rpx;
}

/* 卡片通用样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

/* 指标卡片 */
.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.metric-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
}

.metric-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #2c5f8f;
  display: block;
}

.metric-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 10rpx;
  display: block;
}

/* 按钮 */
.btn-primary {
  background: #2c5f8f;
  color: #fff;
  border-radius: 44rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-blue {
  background: #e8f2f9;
  color: #2c5f8f;
}

.tag-orange {
  background: #fff3e0;
  color: #e67e22;
}

/* 岗位列表项 */
.job-item {
  margin-bottom: 20rpx;
}

/* 搜索栏 */
.search-bar {
  background: #fff;
  border-radius: 44rpx;
  padding: 16rpx 30rpx;
  margin-bottom: 16rpx;
}

.search-input {
  font-size: 28rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.filter-item {
  background: #fff;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}

/* 按钮组 */
.btn-group {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-group button {
  flex: 1;
  margin: 0;
}

.btn-fav {
  background: #fff3e0;
  color: #e67e22;
  border-radius: 44rpx;
}

.btn-fav.faved {
  background: #ffd54f;
  color: #fff;
}

/* 头部 */
.header {
  text-align: center;
  padding: 30rpx 0;
}

.header .title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

/* 快速导航 */
.nav-list {
  margin-top: 10rpx;
}

.nav-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #ccc;
  font-size: 32rpx;
}

/* 城市分布 */
.city-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.city-name {
  width: 100rpx;
  font-size: 26rpx;
}

.city-bar {
  flex: 1;
  height: 20rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.city-bar-fill {
  height: 100%;
  background: #2c5f8f;
  border-radius: 10rpx;
}

.city-count {
  width: 120rpx;
  text-align: right;
  font-size: 24rpx;
  color: #666;
}

/* 地图组件 */
.map {
  width: 100%;
  height: 500rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

/* 城市选择弹窗 */
.city-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 80vh;
  z-index: 999;
}

.city-popup-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.city-search-input {
  background: #f5f7fa;
  border-radius: 30rpx;
  padding: 16rpx 24rpx;
}

.city-list {
  max-height: 50vh;
  overflow-y: auto;
  padding: 20rpx 30rpx;
}

.city-option {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.city-option.selected {
  color: #2c5f8f;
  font-weight: bold;
}

/* 遮罩层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 998;
}
