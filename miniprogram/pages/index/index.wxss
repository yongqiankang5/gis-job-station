.header {
  text-align: center;
  padding: 40rpx 0;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2c5f8f;
}

.subtitle {
  font-size: 24rpx;
  color: #888;
  margin-top: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.nav-list {
  display: flex;
  flex-direction: column;
}

.nav-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #ccc;
  font-size: 36rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
