.job-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.job-salary {
  font-size: 32rpx;
  color: #e67e22;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.job-company {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  color: #888;
}

.value {
  color: #333;
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
}
