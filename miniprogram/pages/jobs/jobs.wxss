.job-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.job-company {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.job-meta {
  margin-bottom: 16rpx;
}

.job-bottom {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}
