<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索岗位、公司名称..." value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="doSearch"/>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <picker bindchange="onCityChange" value="{{selectedCityIndex}}" range="{{cities}}">
      <view class="filter-item">
        {{selectedCity || '全部城市'}} ▾
      </view>
    </picker>
    <picker bindchange="onSalaryChange" range="{{salaryOptions}}">
      <view class="filter-item">
        {{selectedSalary || '全部薪资'}} ▾
      </view>
    </picker>
  </view>

  <!-- 岗位列表 -->
  <view class="job-list">
    <view class="job-item card" wx:for="{{jobs}}" wx:key="id" data-job="{{item}}" bindtap="goToDetail">
      <view class="job-title">{{item.title}}</view>
      <view class="job-company">{{item.company}}</view>
      <view class="job-meta">
        <text class="tag tag-blue">{{item.city}}</text>
        <text class="tag tag-orange" wx:if="{{item.salary_note}}">{{item.salary_note}}</text>
      </view>
      <view class="job-bottom">
        <text class="job-edu">{{item.education}}</text>
        <text class="job-exp">{{item.experience}}</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && jobs.length > 0}}">
    <text>没有更多岗位了</text>
  </view>
</view>
