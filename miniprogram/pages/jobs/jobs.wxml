<view class="container">
  <!-- 岗位列表 -->
  <view class="job-list">
    <view class="job-item card" wx:for="{{jobs}}" wx:key="id" data-job="{{item}}" bindtap="goToDetail">
      <view class="job-title">{{item.title}}</view>
      <view class="job-company">{{item.company}}</view>
      <view class="job-meta">
        <text class="tag tag-blue">{{item.city}}</text>
        <text class="tag tag-orange" wx:if="{{item.salary_note}}">{{item.salary_note}}</text>
      </view>
      <view class="job-bottom">
        <text class="job-edu">{{item.education}}</text>
        <text class="job-exp">{{item.experience}}</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && jobs.length > 0}}">
    <text>没有更多岗位了</text>
  </view>
</view>
