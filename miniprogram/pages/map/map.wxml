<view class="container">
  <view class="card">
    <view class="section-title">全国岗位城市分布</view>
    <map 
      class="map" 
      latitude="35.0" 
      longitude="105.0" 
      scale="4"
      markers="{{markers}}"
    ></map>
  </view>

  <view class="card">
    <view class="section-title">岗位数量TOP10城市</view>
    <view class="city-row" wx:for="{{topCities}}" wx:key="city">
      <text class="city-name">{{item.city}}</text>
      <view class="city-bar">
        <view class="city-bar-fill" style="width: {{item.job_count / topCities[0].job_count * 100}}%"></view>
      </view>
      <text class="city-count">{{item.job_count}} 个岗位</text>
    </view>
  </view>
</view>
