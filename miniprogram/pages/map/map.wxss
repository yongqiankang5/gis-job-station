.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
}

.city-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.city-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.city-name {
  width: 100rpx;
  font-size: 26rpx;
  color: #333;
}

.city-bar {
  flex: 1;
  height: 20rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
}

.city-bar-fill {
  height: 100%;
  background: #2c5f8f;
  border-radius: 10rpx;
}

.city-count {
  width: 120rpx;
  font-size: 24rpx;
  color: #666;
  text-align: right;
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
}
