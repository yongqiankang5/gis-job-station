<view class="container">
  <view class="header">
    <view class="title">事业编制招录信息</view>
  </view>

  <!-- 具体公告列表 -->
  <view class="card" wx:if="{{data.records.length > 0}}">
    <view class="section-title">最新招录公告</view>
    <view class="job-item card" wx:for="{{data.records}}" wx:key="id" bindtap="copyUrl" data-url="{{item.url}}">
      <view class="job-title">{{item.title}}</view>
      <view class="job-company">{{item.unit}}</view>
      <view class="job-meta">
        <text class="tag tag-blue">{{item.province}} {{item.city}}</text>
        <text class="tag tag-orange" wx:if="{{item.count}}">招 {{item.count}} 人</text>
        <text class="tag tag-blue">{{item.year}}年</text>
      </view>
    </view>
  </view>

  <!-- 年度招录统计 -->
  <view class="card">
    <view class="section-title">年度招录统计</view>
    <view class="info-row" wx:for="{{data.by_year}}" wx:key="year">
      <text class="label">{{item.year}}年</text>
      <text class="value">计划 {{item.planned_count}} 人，已招 {{item.actual_count}} 人</text>
    </view>
  </view>

  <!-- 热门专业 -->
  <view class="card">
    <view class="section-title">热门招录专业</view>
    <view class="skill-list">
      <text class="tag tag-blue" wx:for="{{data.major_distribution}}" wx:key="name">{{item.name}} ({{item.count}}人)</text>
    </view>
  </view>
</view>
