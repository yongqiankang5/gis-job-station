# SQLite 默认配置；切换 PostgreSQL 时可改为 postgresql+psycopg://用户:密码@主机/数据库
DATABASE_URL=sqlite:///./data/gis_jobs.db
SECRET_KEY=请替换为随机生成的长字符串
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
REDIS_URL=
ENABLE_SCHEDULER=false
# Linux/Docker 通常为 /usr/bin/chromium；Windows 可填 chrome.exe 的完整路径。
CHROMIUM_PATH=
